# Copy to .env and replace every placeholder. Never commit .env.
# These values are for local development only.

# PostgreSQL
# `jarvis` owns every table and runs migrations. The app connects as the
# non-owner `jarvis_app` role so Postgres actually evaluates row-level
# security (table owners bypass RLS even when it is FORCED). Migrations use
# DATABASE_URL_SYNC (the owner) when running `alembic upgrade`.
POSTGRES_USER=jarvis
# Must match the postgres service in docker-compose.yml. That service
# initializes the volume with this password; a mismatch makes migrations fail.
POSTGRES_PASSWORD=jarvis
POSTGRES_DB=jarvis
# Dev-only default password for the jarvis_app runtime role. Change this in
# every real environment; it is also the fallback the 0009 migration uses
# when this variable is unset.
JARVIS_APP_DB_PASSWORD=change-me-app
DATABASE_URL=postgresql+asyncpg://jarvis_app:change-me-app@localhost:5433/jarvis
# Migration-only connection. alembic always runs as the owner role.
DATABASE_URL_SYNC=postgresql+psycopg://jarvis:jarvis@localhost:5433/jarvis

# Redis
REDIS_URL=redis://localhost:6380/0

# Auth. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-string
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# Encryption key for integration tokens. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# Google OAuth. Leave both blank until a client exists; JARVIS reports
# "not configured" and does not call Google. The redirect must match the
# URI registered on the Google client. It lands on the web app, not the API.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/

# Model provider. Leave the key blank until you have a credential; JARVIS
# reports "not configured" rather than inventing responses.
AI_PROVIDER=openai
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Speech providers. Optional.
STT_PROVIDER=
TTS_PROVIDER=

APP_ENV=development
LOG_LEVEL=INFO

# Durable worker. Ports 5433, 6380, 8000, and 3000 are unchanged.
JOB_MAX_ATTEMPTS=3
JOB_BACKOFF_BASE_SECONDS=2
JOB_BACKOFF_MAX_SECONDS=60
WORKER_CONCURRENCY=2
WORKER_PER_USER_MAX_RUNNING=1
WORKER_POLL_INTERVAL_SECONDS=1
WORKER_LEASE_SECONDS=60
WORKER_HEARTBEAT_SECONDS=15
WORKER_SHUTDOWN_GRACE_SECONDS=20
WORKER_HEALTH_PORT=8091

# Operator view. Leave blank to keep /api/v1/admin closed. A user JWT is not enough.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
ADMIN_TOKEN=
